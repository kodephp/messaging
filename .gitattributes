# 自动检测文本文件并统一换行
* text=auto eol=lf

# PHP 源码
*.php text eol=lf
*.phar binary

# 文档
*.md text eol=lf
*.txt text eol=lf

# 配置文件
*.json text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.neon text eol=lf
*.dist text eol=lf
*.ini text eol=lf
.editorconfig text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
LICENSE text eol=lf

# Shell 脚本
*.sh text eol=lf
bin/* text eol=lf

# Windows 批处理
*.bat text eol=crlf
*.cmd text eol=crlf

# 图像
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary

# 压缩包
*.zip binary
*.gz binary
*.tar binary
*.7z binary
*.rar binary
