<?xml version="1.0" encoding="UTF-8"?>
<!--
  PHPUnit 12 配置文件
  kode/messaging - 统一消息层测试

  注意：此处不声明 <coverage><report>，否则在缺少覆盖率驱动
  （Xdebug / PCOV）的环境下 PHPUnit 12 会拒绝执行测试。
  覆盖率报告改由 `composer coverage` 通过 CLI 参数按需生成。
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         executionOrder="random"
         failOnWarning="true"
         failOnRisky="true"
         failOnEmptyTestSuite="true"
         beStrictAboutCoverageMetadata="true"
         beStrictAboutOutputDuringTests="true"
         displayDetailsOnTestsThatTriggerWarnings="true"
         displayDetailsOnTestsThatTriggerNotices="true"
         displayDetailsOnTestsThatTriggerDeprecations="true"
         enforceTimeLimit="false">

    <testsuites>
        <testsuite name="unit">
            <directory>tests/Unit</directory>
            <exclude>tests/Unit/_fixtures</exclude>
        </testsuite>
        <testsuite name="integration">
            <directory>tests/Integration</directory>
            <exclude>tests/Integration/_fixtures</exclude>
        </testsuite>
        <testsuite name="feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>

    <php>
        <ini name="error_reporting" value="-1"/>
        <ini name="date.timezone" value="UTC"/>
        <ini name="memory_limit" value="-1"/>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="MESSAGING_TEST" value="1" force="true"/>
    </php>
</phpunit>
