# PHPStan 静态分析配置
# level=5: 渐进式严格模式（可选依赖未安装时忽略）
parameters:
    level: 5
    paths:
        - src
    excludePaths:
        analyseAndScan:
            - tests/_fixtures/*
    treatPhpDocTypesAsCertain: false
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        # 测试夹具
        - '#Unsafe usage of new static#'
        # 协议 codec 中允许 union / mixed
        - '#Cannot access offset.*on mixed#'
        # Version::PRE_RELEASE 的运行时比较
        - '#Strict comparison using !== between .* and .* will always evaluate to false#'
        # 构造函数兼容父类签名，未使用参数
        - '#Constructor of class.*has an unused parameter#'
        # 可选依赖（Workerman / Swoole / Swow）未安装时的类型解析
        - '#Class Workerman\\.*not found#'
        - '#Class Swoole\\.*not found#'
        - '#Class Swow\\.*not found#'
        - '#invalid type Workerman\\#'
        - '#invalid type Swoole\\#'
        - '#invalid type Swow\\#'
        - '#on an unknown class Workerman\\#'
        - '#on an unknown class Swoole\\#'
        - '#on an unknown class Swow\\#'
