# PHPStan 静态分析配置
# level=5: 渐进式严格模式（可选依赖未安装时忽略）
parameters:
    level: 5
    paths:
        - src
    excludePaths:
        analyseAndScan:
            - tests/_fixtures/*
    treatPhpDocTypesAsCertain: false
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        # 测试夹具
        - '#Unsafe usage of new static#'
        # 协议 codec 中允许 union / mixed
        - '#Cannot access offset.*on mixed#'
        # Version::PRE_RELEASE 的运行时比较
        - '#Strict comparison using !== between .* and .* will always evaluate to false#'
        # 构造函数兼容父类签名，未使用参数
        - '#Constructor of class.*has an unused parameter#'
        # 协程 Transport 的 select() 实现不会失败，但必须保留接口契约的 array|false
        # （TransportInterface::select 与 stream_select 语义对齐，StreamTransport 会返回 false）
        - '#Method Kode\\Messaging\\Transport\\(Swoole|Swow)Transport::select\(\) never returns false#'
        # 可选依赖（Predis / Kode\Process / Swoole / Swow / Workerman）未安装时的类型解析
        # 覆盖 PHPStan 实际报出的多种措辞
        - '#has (unknown class|invalid return type) (Predis|Swoole|Swow|Workerman|Kode\\Process)\\#i'
        - '#Instantiated class (Predis|Swoole|Swow|Workerman|Kode\\Process)\\.*not found#i'
        - '#on an unknown class (Predis|Swoole|Swow|Workerman|Kode\\Process)\\#i'
        - '#Call to (method|static method) .* on an unknown class (Predis|Swoole|Swow|Workerman|Kode\\Process)\\#i'
        - '#Class (Predis|Swoole|Swow|Workerman|Kode\\Process)\\.*not found#i'
        - '#invalid type (Predis|Swoole|Swow|Workerman|Kode\\Process)\\#i'
