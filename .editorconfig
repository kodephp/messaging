# EditorConfig 统一编辑器行为
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 120

[*.{md,yml,yaml,json,xml,neon}]
indent_size = 2
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf

[*.sh]
end_of_line = lf

[Makefile]
indent_style = tab

[*.{ts,tsx,js,jsx,vue}]
indent_size = 2

[composer.json]
indent_size = 4
